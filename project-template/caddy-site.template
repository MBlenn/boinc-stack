# BOINC project ${PROJECT} -> 127.0.0.1:${WEB_PORT} (rootless containers of boinc-${PROJECT})
${SITE_ADDRESS} {
${BIND_LINE}
	# do not reveal server software (Caddy's own header and Apache's)
	header -Server
	reverse_proxy 127.0.0.1:${WEB_PORT} {
		header_down -Server
	}
	log {
		output file /var/log/caddy/${PROJECT}.log
	}
}
