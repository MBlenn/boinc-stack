#!/usr/bin/env python3
"""Install and feed Docker-based BOINC apps.

Run inside the daemons container (as root via `podman exec` or as boincadm):

    boinc-app list                          apps in the image and apps installed in the project
    boinc-app install <app> [--from SRC]    register app, plan class, app version, templates, daemons
    boinc-app submit <app> [N]              create N jobs (default 1)
    boinc-app results <app>                 show the result files collected by the assimilator

SRC is where the app definition comes from (default: the apps shipped in this image):
    https://github.com/OWNER/REPO[@REF]     a GitHub repository (REF: branch, tag or commit,
                                            default main) with the app in apps/<app>/
    /some/path                              a directory containing apps/<app>/ or <app>/

install copies the app definition into the project (<project>/boinc_apps/<app>/, the
origin is recorded in SOURCE). submit and results use that copy, so later image or
repository changes only take effect after another install.

An app definition (<source>/apps/<app>/) contains:
    app.env              APP_NAME, APP_TITLE, APP_VERSION, PLAN_CLASS,
                         optional VALIDATOR / ASSIMILATOR (daemon command lines)
    plan_class.xml       <plan_class> block added to plan_class_spec.xml
    files/               Dockerfile, main.sh, job.toml, ... (@APP_VERSION@ is substituted)
    templates/in.xml     input template, templates/out.xml output template
    server/              optional: scripts copied to the project's bin/ (e.g. a validator)
    jobs.py              optional: make_jobs(count, rng, stamp, testdata) for "submit";
                         without it, jobs without input files are created
    testdata/            optional: input files referenced by jobs.py
"""
import hashlib
import importlib.util
import random
import html
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

APPS_DIR = "/usr/local/share/boinc-stack/apps"   # apps shipped in the image
SNAPSHOT_DIR = "boinc_apps"                        # per project: installed app definitions
WRAPPER = "/usr/local/lib/boinc-stack/docker_wrapper"
PLATFORM = "x86_64-pc-linux-gnu"


def die(msg):
    print(f"boinc-app: {msg}", file=sys.stderr)
    sys.exit(1)


def drop_privileges():
    """Re-run as boincadm so that all project files keep the right owner."""
    if os.geteuid() == 0:
        os.execvp("runuser", ["runuser", "-u", "boincadm", "--",
                              "env", "HOME=/home/boincadm", "USER=boincadm",
                              sys.executable, *sys.argv])


def project_root():
    project = os.environ.get("PROJECT") or die("PROJECT is not set")
    root = f"/home/boincadm/projects/{project}"
    if not os.path.isfile(os.path.join(root, "config.xml")):
        die(f"project {project} not found in {root}")
    return root


def valid_name(name):
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,31}", name):
        die(f"invalid app name '{name}' (lowercase letters, digits, underscore)")
    return name


def load_app(name, d=None):
    """Read app.env. Without d: the copy installed in the project, else the image's app."""
    valid_name(name)
    if d is None:
        d = os.path.join(project_root(), SNAPSHOT_DIR, name)
        if not os.path.isfile(os.path.join(d, "app.env")):
            d = os.path.join(APPS_DIR, name)
    if not os.path.isfile(os.path.join(d, "app.env")):
        die(f"unknown app '{name}' (see 'boinc-app list')")
    env = {}
    for line in open(os.path.join(d, "app.env"), encoding="utf-8"):
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, v = line.split("=", 1)
            env[k.strip()] = v.strip()
    for k in ("APP_NAME", "APP_TITLE", "APP_VERSION", "PLAN_CLASS"):
        if not env.get(k):
            die(f"{k} missing in {d}/app.env")
    env.setdefault("VALIDATOR", f"sample_trivial_validator --app {env['APP_NAME']}")
    env.setdefault("ASSIMILATOR", f"sample_assimilator --app {env['APP_NAME']}")
    if env["APP_NAME"] != name:
        die(f"{d}/app.env: APP_NAME={env['APP_NAME']} does not match the directory name {name}")
    env["DIR"] = d
    return env


def parse_github(src):
    m = re.fullmatch(r"https://github\.com/([\w.-]+)/([\w.-]+?)(?:\.git)?/?(?:@([\w./-]+))?", src)
    return m.groups() if m else None


def fetch_source(src, name, workdir):
    """Return (app directory, description of the origin) for --from SRC."""
    gh = parse_github(src)
    if gh:
        owner, repo, ref = gh[0], gh[1], gh[2] or "main"
        url = f"https://github.com/{owner}/{repo}/archive/{ref}.tar.gz"
        print(f"downloading {url}")
        tgz = os.path.join(workdir, "src.tar.gz")
        try:
            with urllib.request.urlopen(url, timeout=120) as r, open(tgz, "wb") as f:
                shutil.copyfileobj(r, f)
        except OSError as e:
            die(f"download failed: {e}")
        with tarfile.open(tgz) as t:
            t.extractall(workdir, filter="data")
        tops = [e for e in os.listdir(workdir) if os.path.isdir(os.path.join(workdir, e))]
        if len(tops) != 1:
            die(f"unexpected archive layout in {url}")
        base, origin = os.path.join(workdir, tops[0]), f"https://github.com/{owner}/{repo}@{ref}"
    elif src.startswith("/"):
        base, origin = src, src
    else:
        die(f"--from: expected https://github.com/OWNER/REPO[@REF] or an absolute path, got '{src}'")
    for d in (os.path.join(base, "apps", name), os.path.join(base, name), base):
        if os.path.isfile(os.path.join(d, "app.env")) and os.path.basename(os.path.normpath(d)) == name:
            return d, origin
    die(f"app '{name}' not found in {origin} (expected apps/{name}/app.env)")


def snapshot_app(root, src_dir, name, origin):
    """Copy the app definition into the project; submit/results/validators use this copy."""
    dst = os.path.join(root, SNAPSHOT_DIR, name)
    tmp = dst + ".new"
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src_dir, tmp, symlinks=False)
    with open(os.path.join(tmp, "SOURCE"), "w", encoding="utf-8") as f:
        f.write(f"{origin}\n{time.strftime('%Y-%m-%d %H:%M:%S')}\n")
    shutil.rmtree(dst, ignore_errors=True)
    os.rename(tmp, dst)
    print(f"app definition: {SNAPSHOT_DIR}/{name} (from {origin})")
    return dst


def run(cmd, root, stdin=None):
    print("  $", " ".join(cmd))
    r = subprocess.run(cmd, cwd=root, input=stdin, text=True)
    if r.returncode != 0:
        die(f"command failed ({r.returncode}): {' '.join(cmd)}")


def sha8(path):
    return hashlib.sha256(open(path, "rb").read()).hexdigest()[:8]


def ensure_plan_class(root, app):
    path = os.path.join(root, "plan_class_spec.xml")
    block = open(os.path.join(app["DIR"], "plan_class.xml"), encoding="utf-8").read().rstrip() + "\n"
    if os.path.exists(path):
        xml = open(path, encoding="utf-8").read()
    else:
        xml = "<plan_classes>\n</plan_classes>\n"
    if re.search(r"<name>\s*%s\s*</name>" % re.escape(app["PLAN_CLASS"]), xml):
        print(f"plan class {app['PLAN_CLASS']}: already present")
        return
    xml = xml.replace("</plan_classes>", block + "</plan_classes>")
    open(path, "w", encoding="utf-8").write(xml)
    print(f"plan class {app['PLAN_CLASS']}: added to plan_class_spec.xml")


def ensure_app_in_project_xml(root, app):
    path = os.path.join(root, "project.xml")
    xml = open(path, encoding="utf-8").read()
    if re.search(r"<name>\s*%s\s*</name>" % re.escape(app["APP_NAME"]), xml):
        print(f"app {app['APP_NAME']}: already in project.xml")
    else:
        entry = ("    <app>\n"
                 f"        <name>{app['APP_NAME']}</name>\n"
                 f"        <user_friendly_name>{app['APP_TITLE']}</user_friendly_name>\n"
                 "    </app>\n")
        xml = xml.replace("</boinc>", entry + "</boinc>")
        open(path, "w", encoding="utf-8").write(xml)
        print(f"app {app['APP_NAME']}: added to project.xml")
    run(["bin/xadd"], root)


def build_app_version(root, app):
    name, ver = app["APP_NAME"], app["APP_VERSION"]
    vdir = os.path.join(root, "apps", name, ver, f"{PLATFORM}__{app['PLAN_CLASS']}")
    if os.path.isdir(vdir):
        print(f"app version {ver} ({app['PLAN_CLASS']}): directory exists, keeping it "
              "(raise APP_VERSION to deploy changed files)")
        return
    os.makedirs(vdir)
    # docker_wrapper: physical name carries a content hash, so different builds never collide
    wrapper_name = f"docker_wrapper_{PLATFORM}_{sha8(WRAPPER)}"
    shutil.copy2(WRAPPER, os.path.join(vdir, wrapper_name))
    os.chmod(os.path.join(vdir, wrapper_name), 0o755)
    files = [f'    <file>\n        <physical_name>{wrapper_name}</physical_name>\n'
             '        <main_program/>\n    </file>\n']
    for fn in sorted(os.listdir(os.path.join(app["DIR"], "files"))):
        src = os.path.join(app["DIR"], "files", fn)
        content = open(src, encoding="utf-8").read().replace("@APP_VERSION@", ver)
        base, ext = os.path.splitext(fn)
        phys = f"{name}_{ver}_{base}{ext}"
        open(os.path.join(vdir, phys), "w", encoding="utf-8").write(content)
        files.append(f'    <file>\n        <physical_name>{phys}</physical_name>\n'
                     f'        <logical_name>{fn}</logical_name>\n        <copy_file/>\n    </file>\n')
    open(os.path.join(vdir, "version.xml"), "w", encoding="utf-8").write(
        "<version>\n" + "".join(files) + "</version>\n")
    print(f"app version {ver} ({app['PLAN_CLASS']}): files prepared in {vdir}")
    run(["bin/update_versions", "--noconfirm"], root)


def install_templates(root, app):
    for kind in ("in", "out"):
        src = os.path.join(app["DIR"], "templates", f"{kind}.xml")
        dst = os.path.join(root, "templates", f"{app['APP_NAME']}_{kind}")
        shutil.copyfile(src, dst)
    print(f"templates: templates/{app['APP_NAME']}_in, templates/{app['APP_NAME']}_out")


def install_server_scripts(root, app):
    sdir = os.path.join(app["DIR"], "server")
    if not os.path.isdir(sdir):
        return
    for fn in sorted(os.listdir(sdir)):
        dst = os.path.join(root, "bin", fn)
        shutil.copyfile(os.path.join(sdir, fn), dst)
        os.chmod(dst, 0o755)
        print(f"server script: bin/{fn}")


def ensure_daemons(root, app):
    """Validator and assimilator per app (own log and pid names).

    An existing daemon entry with the same output file is replaced, so changing
    VALIDATOR/ASSIMILATOR in app.env and re-running install takes effect."""
    path = os.path.join(root, "config.xml")
    xml = open(path, encoding="utf-8").read()
    n = app["APP_NAME"]
    changed = []
    for cmd, tag in ((app["VALIDATOR"], f"validator_{n}"), (app["ASSIMILATOR"], f"assimilator_{n}")):
        entry = ("        <daemon>\n"
                 f"            <cmd>{html.escape(cmd, quote=False)}</cmd>\n"
                 f"            <output>{tag}.log</output>\n"
                 f"            <pid_file>{tag}.pid</pid_file>\n"
                 "        </daemon>\n")
        old = re.search(r"[ \t]*<daemon>(?:(?!</daemon>).)*<output>%s\.log</output>.*?</daemon>\n"
                        % re.escape(tag), xml, re.S)
        if old and old.group(0) == entry:
            continue
        if old:
            xml = xml.replace(old.group(0), entry, 1)
        else:
            xml = xml.replace("</daemons>", entry + "    </daemons>", 1)
        changed.append(cmd)
    if changed:
        open(path, "w", encoding="utf-8").write(xml)
        for c in changed:
            print(f"daemon: {c}")
    else:
        print("daemons: already configured")


def restart_daemons(root):
    # the feeder only learns about new apps and app versions at startup
    run(["bin/stop"], root)
    time.sleep(2)
    run(["bin/start"], root)


def list_dir(base):
    rows = []
    if os.path.isdir(base):
        for name in sorted(os.listdir(base)):
            if os.path.isfile(os.path.join(base, name, "app.env")):
                try:
                    rows.append((name, load_app(name, os.path.join(base, name))))
                except SystemExit:
                    pass
    return rows


def cmd_list():
    root = project_root()
    print("Installed in this project:")
    rows = list_dir(os.path.join(root, SNAPSHOT_DIR))
    for name, app in rows:
        src = open(os.path.join(app["DIR"], "SOURCE"), encoding="utf-8").readline().strip() \
            if os.path.isfile(os.path.join(app["DIR"], "SOURCE")) else "?"
        print(f"  {name:12} {app['APP_VERSION']:6} {app['PLAN_CLASS']:20} {src}")
    if not rows:
        print("  (none)")
    print("Shipped in the image (boinc-app install <app>):")
    for name, app in list_dir(APPS_DIR):
        print(f"  {name:12} {app['APP_VERSION']:6} {app['PLAN_CLASS']:20} {app['APP_TITLE']}")
    print("More apps: boinc-app install <app> --from https://github.com/MBlenn/boinc-apps")


def cmd_install(name, src=None):
    root = project_root()
    valid_name(name)
    if not os.path.isfile(WRAPPER):
        die(f"{WRAPPER} missing in this image")
    with tempfile.TemporaryDirectory() as work:
        if src:
            src_dir, origin = fetch_source(src, name, work)
        else:
            src_dir, origin = os.path.join(APPS_DIR, name), "image"
            if not os.path.isfile(os.path.join(src_dir, "app.env")):
                die(f"app '{name}' is not shipped in the image; use --from SRC (see 'boinc-app list')")
        load_app(name, src_dir)          # validate before touching the project
        app = load_app(name, snapshot_app(root, src_dir, name, origin))
    ensure_plan_class(root, app)
    ensure_app_in_project_xml(root, app)
    build_app_version(root, app)
    install_templates(root, app)
    install_server_scripts(root, app)
    ensure_daemons(root, app)
    restart_daemons(root)
    print(f"\n{name} installed. Create jobs with: boinc-app submit {name} [N]")


def stage_input(root, app, path):
    """Copy a test data file into the download hierarchy (once); return its physical name.
    The name carries a content hash, so changed test data never collides with old jobs."""
    phys = f"{app['APP_NAME']}_{sha8(path)}_{os.path.basename(path)}"
    dst = subprocess.run(["bin/dir_hier_path", phys], cwd=root, capture_output=True,
                         text=True, check=True).stdout.strip()
    if not os.path.exists(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copyfile(path, dst)
    return phys


def load_jobs_module(app):
    path = os.path.join(app["DIR"], "jobs.py")
    if not os.path.isfile(path):
        return None
    spec = importlib.util.spec_from_file_location(f"jobs_{app['APP_NAME']}", path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def cmd_submit(name, count):
    root, app = project_root(), load_app(name)
    n = app["APP_NAME"]
    if not os.path.isfile(os.path.join(root, "templates", f"{n}_in")):
        die(f"{n} is not installed yet (boinc-app install {n})")
    stamp = time.strftime("%Y%m%d_%H%M%S")
    base = ["bin/create_work", "--appname", n,
            "--wu_template", f"templates/{n}_in", "--result_template", f"templates/{n}_out"]
    jobs_mod = load_jobs_module(app)
    if jobs_mod is None:
        for i in range(count):
            run(base + ["--wu_name", f"{n}_{stamp}_{i}"], root)
        print(f"{count} job(s) created for {n}")
        return
    testdata = os.path.join(app["DIR"], "testdata")
    jobs = jobs_mod.make_jobs(count, random.Random(), stamp, testdata)
    kinds = {}
    for job in jobs:
        files = [stage_input(root, app, os.path.join(testdata, f)) for f in job["inputs"]]
        cmd = base + ["--wu_name", job["name"]] + job.get("options", [])
        if job.get("args"):
            cmd += ["--command_line", job["args"]]
        run(cmd + files, root)
        kind = job["name"].split("_")[1]
        kinds[kind] = kinds.get(kind, 0) + 1
    print(f"{len(jobs)} job(s) created for {n}: " +
          ", ".join(f"{k} {v}" for k, v in sorted(kinds.items())))


def cmd_results(name):
    root, app = project_root(), load_app(name)
    rdir = os.path.join(root, "results")
    found = False
    for dirpath, _, files in sorted(os.walk(rdir)):
        for fn in sorted(files):
            if not fn.startswith(app["APP_NAME"] + "_"):
                continue
            found = True
            path = os.path.join(dirpath, fn)
            print(f"=== {os.path.relpath(path, root)}")
            print(open(path, encoding="utf-8", errors="replace").read().rstrip())
    if not found:
        print(f"no results for {app['APP_NAME']} in {rdir} yet")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    drop_privileges()
    cmd = args[0]
    if cmd == "list":
        cmd_list()
    elif cmd == "install" and len(args) == 2:
        cmd_install(args[1])
    elif cmd == "install" and len(args) == 4 and args[2] == "--from":
        cmd_install(args[1], args[3])
    elif cmd == "submit" and len(args) in (2, 3):
        cmd_submit(args[1], int(args[2]) if len(args) == 3 else 1)
    elif cmd == "results" and len(args) == 2:
        cmd_results(args[1])
    else:
        print(__doc__)
        sys.exit(1)


if __name__ == "__main__":
    main()
