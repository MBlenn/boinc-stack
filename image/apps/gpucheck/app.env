# BOINC app "gpucheck": reports whether an NVIDIA GPU is visible inside a Docker/Podman container.
APP_NAME=gpucheck
APP_TITLE=GPU check
APP_VERSION=1.8
# plan class from plan_class.xml; selects hosts with Docker/Podman and an NVIDIA GPU
PLAN_CLASS=docker_nvidia
# at most one gpucheck task per host at a time: it is a setup check, a volunteer needs
# one valid result, not a queue of them (config_aux.xml, see docs/docker-apps.md)
MAX_IN_PROGRESS=1
