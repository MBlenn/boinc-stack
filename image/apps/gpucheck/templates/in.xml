<!-- no input files: the job only inspects the host -->
<workunit>
    <rsc_fpops_est>1e12</rsc_fpops_est>
    <!-- generous bound: the first job on a host also builds the container image -->
    <rsc_fpops_bound>1e17</rsc_fpops_bound>
    <rsc_memory_bound>500000000</rsc_memory_bound>
    <rsc_disk_bound>2000000000</rsc_disk_bound>
    <delay_bound>86400</delay_bound>
    <min_quorum>1</min_quorum>
    <target_nresults>1</target_nresults>
    <max_error_results>3</max_error_results>
    <max_total_results>5</max_total_results>
    <max_success_results>1</max_success_results>
</workunit>
