+// local time "YYYY-MM-DD HH:MM:SS" for log messages
+//
+static const char* docker_log_time() {
+    static char buf[32];
+    time_t t = time(0);
+    strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", localtime(&t));
