+// Messages to the task's stderr with a timestamp, so that the time spent in
+// each step (image pull and build, container run, cleanup) can be seen.
+//
+static void wlog(const char* fmt, ...) {
+    char buf[32];
+    time_t t = time(0);
+    strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", localtime(&t));
+    fprintf(stderr, "%s ", buf);
+    va_list ap;
+    va_start(ap, fmt);
+    vfprintf(stderr, fmt, ap);
+    va_end(ap);
+}
+
