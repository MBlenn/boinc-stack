+// along with BOINC.  If not, see <http://www.gnu.org/licenses/>.
+
+// Helpers for admin pages that show a user's settings in a readable way:
+// project preferences per venue, the user's computers and which venue's
+// preferences apply to each of them, special user flags, status messages.
+
+require_once("../inc/util.inc");
+require_once("../inc/prefs.inc");
+require_once("../inc/prefs_project.inc");
+require_once("../inc/forum.inc");
+
+function ops_h($s) {
+    return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8');
+}
+
+// Show a status message (e.g. after an update) as a Bootstrap alert.
+// $ok: true = success (green), false = failure (red)
+//
+function ops_alert($msg, $ok=true) {
+    // inline colors as well, in case the admin pages are shown without Bootstrap
+    $class = $ok ? "alert-success" : "alert-danger";
+    $style = $ok
+        ? "background: #dff0d8; color: #3c763d; border: 1px solid #d6e9c6;"
+        : "background: #f2dede; color: #a94442; border: 1px solid #ebccd1;";
+    echo "<div class=\"alert $class\" role=\"alert\" style=\"$style padding: 10px; margin: 10px 0;\">$msg</div>\n";
+}
+
+// Names of the special user flags that are set, e.g. "Project administrator, Project tester"
+//
+function ops_special_user_names($bits) {
+    global $special_user_bitfield;
+    $names = array();
+    for ($i=0; $i<S_NFLAGS; $i++) {
+        if (substr((string)$bits, $i, 1) == '1' && isset($special_user_bitfield[$i])) {
+            $names[] = $special_user_bitfield[$i];
+        }
+    }
+    return implode(", ", $names);
+}
+
+// The venue whose project preferences apply to a host.
+// Same rule as the scheduler (extract_venue()): the host's venue if the
+// user has separate preferences for it, otherwise the default preferences.
+//
+function ops_effective_venue($prefs, $host_venue) {
+    if ($host_venue && isset($prefs->$host_venue) && $prefs->$host_venue) {
+        return $host_venue;
+    }
+    return "";
+}
+
+function ops_venue_name($venue) {
+    return $venue ? ucfirst($venue) : "Default";
+}
+
+// Coprocessors etc. from host.serialnum, e.g.
+// "[BOINC|8.2.9][CUDA|NVIDIA GeForce RTX 4070|1|12282MB|...][docker|...]"
+// Returns array of short strings.
+//
+function ops_host_features($host) {
+    $out = array();
+    if (preg_match_all('/\[([^\]]*)\]/', (string)$host->serialnum, $m)) {
+        foreach ($m[1] as $item) {
+            $f = explode("|", $item);
+            if ($f[0] == "BOINC") {
+                $out[] = "BOINC ".ops_h($f[1] ?? "");
+            } else if (in_array($f[0], array("CUDA", "CAL", "INTEL", "apple_gpu", "opencl_gpu"))) {
+                $name = $f[1] ?? "";
+                $count = $f[2] ?? "";
+                $mem = $f[3] ?? "";
+                $out[] = ops_h(($count && $count != "1" ? "$count x " : "")."$name".($mem ? " ($mem)" : ""));
+            } else if ($f[0] != "") {
+                $out[] = ops_h(implode(" ", $f));
+            }
+        }
+    }
+    return $out;
+}
+
+// Project preferences of a user: one column per venue,
+// like the "Switch View" table that volunteers see.
+//
+function ops_show_project_prefs($user) {
+    $prefs = prefs_parse_project($user->project_prefs);
+    start_table("table-striped");
+    row_top("Setting");
+    prefs_show_project($prefs, true);
+    prefs_show_project_specific($prefs, true);
+    end_table();
+
+    $venues = array();
+    foreach (array("home", "school", "work") as $v) {
+        if (isset($prefs->$v) && $prefs->$v) $venues[] = ops_venue_name($v);
+    }
+    echo "<p class=\"text-muted\">\"--\" means the user has no separate preferences for that venue";
+    echo $venues ? " (separate preferences exist for: ".implode(", ", $venues).")" : " (only default preferences)";
+    echo ". A computer uses the preferences of its venue if they exist, otherwise the default ones.</p>\n";
+
+    if (trim((string)$user->project_prefs) != "") {
+        echo "<details><summary>Raw preferences XML</summary><pre>"
+            .ops_h($user->project_prefs)."</pre></details>\n";
+    }
+}
+
+// The user's computers: venue, which preferences apply, last contact, GPUs
+//
+function ops_show_user_hosts($user) {
+    $prefs = prefs_parse_project($user->project_prefs);
+    $hosts = BoincHost::enum("userid=$user->id", "order by rpc_time desc");
+    if (!$hosts) {
+        echo "<p>No computers.</p>\n";
+        return;
+    }
+    start_table("table-striped");
+    table_header("Computer", "Venue", "Preferences used", "Last contact", "Hardware / client");
+    foreach ($hosts as $host) {
+        $eff = ops_effective_venue($prefs, $host->venue);
+        $used = ops_venue_name($eff);
+        if ($host->venue && !$eff) {
+            $used .= " <small class=\"text-muted\">(no separate ".ops_h($host->venue)." preferences)</small>";
+        }
+        $name = $host->domain_name ? ops_h($host->domain_name) : "(hidden)";
+        table_row(
+            "<a href=\"".url_base()."show_host_detail.php?hostid=$host->id\">$host->id</a> $name",
+            ops_venue_name($host->venue),
+            $used,
+            $host->rpc_time ? time_str($host->rpc_time) : "never",
+            implode("<br>", ops_host_features($host))
+        );
+    }
+    end_table();
+}
+
+?>
